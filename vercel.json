{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/|assets/|_vercel/).*)",
      "destination": "/api/page?path=$1"
    }
  ],
  "images": {
    "sizes": [
      256,
      384,
      640,
      960,
      1280,
      1920
    ],
    "domains": [],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "7ofla7zuue2h7rgx.public.blob.vercel-storage.com"
      }
    ],
    "formats": [
      "image/webp"
    ],
    "qualities": [
      75
    ],
    "minimumCacheTTL": 2678400
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/page.ts": {
      "includeFiles": "dist/index.html"
    }
  }
}
